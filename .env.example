# Telegram bot token (BotFather -> /revoke -> yangi token oling, eskisini hech qachon kodga yozmang)
BOT_TOKEN=

# Sizning shaxsiy Telegram ID raqamingiz (asosiy admin)
ADMIN_ID=

# PostgreSQL ulanish manzili
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/edutest

# Akademiya nomi (sertifikatlarda ko'rinadi)
ACADEMY_NAME=Smart Edu Center

# To'lov karta ma'lumotlari
PAYMENT_CARD=0000 0000 0000 0000
PAYMENT_OWNER=F.I.Sh.
PAYMENT_PHONE=+998 90 000 00 00

# Necha soatda bir marta ma'lumotlar bazasi avtomatik zaxira nusxasi (JSON)
# ADMIN_ID'ga Telegram orqali yuborilsin. 0 = o'chirilgan.
DB_BACKUP_INTERVAL_HOURS=24

# Mini App (veb-profil): bot menyusida "🌐 Veb-profil" tugmasi ko'rinishi uchun
# shu yerga public HTTPS manzil yozing (Telegram web_app tugmasi faqat HTTPS
# bilan ishlaydi). Masalan: https://sizning-domen.uz yoki vaqtincha sinov
# uchun ngrok/cloudflared orqali olingan https manzil. Bo'sh qoldirsangiz,
# tugma ko'rsatilmaydi, lekin server baribir mahalliy portda ishga tushadi.
WEBAPP_URL=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# AI baholash (Writing / Esse / Rasch tekshiruvi).
# Asosiy AI — Claude: kalitni https://console.anthropic.com -> API Keys bo'limidan oling
# (Claude Pro/Max obunasi API kalit EMAS — API hisobi alohida to'ldiriladi).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Zaxira AI — Gemini (Claude ishlamasa avtomatik ishga tushadi; Speaking ovozini faqat Gemini eshitadi).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
